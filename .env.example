# Project directory Claude Code will work in
CLAUDE_CWD=/Users/dennisk/Hub/focus/client - biblechat/project - bib content gen

# Model to use (optional, defaults to claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6
